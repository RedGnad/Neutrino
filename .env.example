# Mantle network — pick one. Phase 2 (Sept 2026 onwards) is mainnet.
NEUTRINO_NETWORK=mantle                    # 'mantle' (mainnet) or 'mantle_sepolia'
MANTLE_MAINNET_RPC=https://rpc.mantle.xyz
MANTLE_SEPOLIA_RPC=https://rpc.sepolia.mantle.xyz
# MANTLE_RPC=                              # explicit override (optional)
MANTLESCAN_API_KEY=                        # contract verification

# --- Wallets / signing ---
DEPLOYER_PRIVATE_KEY=0x...                 # for forge script Deploy.s.sol; never commit
AGENT_RUNNER_PRIVATE_KEY=0x...             # signs decision logs and execution txs in /api/run-agent

# --- Reference price feed ---
TWELVE_DATA_API_KEY=                       # https://twelvedata.com (free tier 8 req/min)

# --- LLM narration (Anthropic Claude) ---
# Either CLAUDE_API_KEY or ANTHROPIC_API_KEY works; code accepts both.
CLAUDE_API_KEY=
ANTHROPIC_API_KEY=

# --- ERC-8004 canonical agent identity (Mantle per-chain singletons) ---
# IdentityRegistry verified on Mantlescan; see erc-8004/erc-8004-contracts.
#   Mantle Mainnet (5000): 0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
#   Mantle Testnet:        0x8004A818BFB912233c491871b3d84c89A494BD9e
NEXT_PUBLIC_ERC8004_IDENTITY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
# agentURI the registry token resolves to (served by /agent-card.json).
AGENT_CARD_URI=https://neutrino-fawn.vercel.app/agent-card.json
NEXT_PUBLIC_SITE_URL=https://neutrino-fawn.vercel.app
# Wallet that signs decision logs in /api/run-agent. If different from the
# DEPLOYER (= agent owner), the register script approves it as an operator.
AGENT_OPERATOR_ADDRESS=

# --- Deployed contracts ---
# Legacy V1 (bespoke RWAAgent NFT) — kept for historical receipts only.
NEXT_PUBLIC_RWA_AGENT_ADDRESS=
# RWADecisionLoggerV2 — bound to the canonical ERC-8004 IdentityRegistry.
# Filled after `forge script script/RegisterAgentAndDeployLogger.s.sol`.
NEXT_PUBLIC_RWA_DECISION_LOGGER_ADDRESS=
# Canonical ERC-8004 agentId returned by register() (NOT the old "1").
NEXT_PUBLIC_DEFAULT_AGENT_ID=

# --- On-chain execution (Phase 2, mainnet only) ---
EXECUTE_ON_CHAIN=false                     # 'true' to enable Fluxion swap + INIT supply
EXECUTE_ACTION=move-to-stable-yield        # 'allocate' or 'move-to-stable-yield'
EXECUTE_AMOUNT_USDC_BASE_UNITS=1000000     # 1 USDC = 1_000_000 (USDC has 6 decimals)
EXECUTE_SLIPPAGE_BPS=50                    # 50 bps = 0.5%
EXECUTE_ROUNDTRIP=true                     # true=demo round-trip (USDC→mETH→USDC); false=production hold
